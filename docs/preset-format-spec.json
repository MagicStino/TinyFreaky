{
  "status": "Legacy archive parser. Sequence and sample payloads remain unsupported.",
  "container": {
    "mfprojz": "ZIP with arbitrary nested directories and .mbp files. Ignore directories and metadata/empty slots.",
    "mfpz": "Expected analogous ZIP single preset; not verified in collected fixture.",
    "mbp": "Boost text serialization, starts 22 serialization::archive. Not XML or JSON. Length-prefixed string fields allow spaces in preset name.",
    "example_prefix_structure": "22 serialization::archive 10 0 4 [version-like values] [name_length] [name] [category and metadata] 18 [18-character flags] [metadata] [payload_byte_count] [decimal payload bytes]",
    "payload_locator": "A count token followed by that many decimal values in range 0..127; packed payload starts 0 35 86 67 79. Do not hardcode count: observed 4672.",
    "safety": "Validate count, byte range, complete input, ZIP size limits, and archive member traversal; never extract untrusted paths."
  },
  "packing": {
    "scheme": "7-bit SysEx MSB prefix. For each 8 packed bytes, first is mask; subsequent up to 7 bytes are low seven bits. Bit j of mask supplies bit7 of following byte j. Concatenate across transport packets before unpacking.",
    "observed_packed_size": 4672,
    "observed_unpacked_size": 4088
  },
  "records": {
    "section": "ASCII # followed by 3-byte group, often preceded by @. Example #VCO.",
    "field": "byte 0x40+N, N ASCII name bytes, literal 0x63, three value bytes.",
    "value": "resolution byte R, then unsigned little-endian 16-bit Q. Continuous Q15 generally Q/32768; modulation signed int16(Q)/32768. Preserve all 3 bytes.",
    "discrete": "R often supplies scaling count. Q commonly multiples 32768/R. Modes generally derive round(Q*R/32768). Type uses one-based steps; see engines.",
    "termination": "@ closes group. @ followed by space observed before binary sequence region. Stop named scanning before this region.",
    "warning": "Known field offsets vary by firmware; use names and lengths. Some factories use different layouts. Unknown records must remain preserved."
  },
