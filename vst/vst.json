{
  "name": "Tinyfreaky",
  "vendor": "MagicStino",
  "uid": "TyFk",
  "version": 2020,
  "so": "tinyfreaky.so",
  "params": "params.json",
  "layout": "layout.conf",
  "cc": false,
  "programs": {
    "param": "preset"
  },
  "build": {
    "root": "..",
    "sources": [
      "src/engine.c"
    ],
    "cflags": [
      "-std=c99"
    ],
    "libs": [
      "-lm"
    ]
  },
  "defines": {
    "SAMPLE_ACCURATE": 1,
    "HAS_SONG_POS": 1,
    "MODULE_SUBDIR": "\"presets\"",
    "PARAM_TEXT_MAX": 128
  },
  "art": "html"
}
